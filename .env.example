# Copy to .env. Read by Spring through spring.config.import, from the working
# directory. There are no profiles: localhost and the VM run the same
# configuration, only this file differs.

DATABASE_URL=jdbc:postgresql://localhost:5432/argus
DATABASE_USER=app
DATABASE_PASSWORD=change-me

# Comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# First ADMIN account, created by migration V2. Both required: an unset Flyway
# placeholder fails startup, which beats shipping a known password. Generate the
# hash with:
#   docker run --rm httpd:alpine htpasswd -bnBC 10 "" 'the-password' | cut -d: -f2
ADMIN_EMAIL=admin@argus.local
ADMIN_PASSWORD_HASH=

# Optional. Left blank, an ephemeral pair is generated at startup and warned about:
# every token dies on restart and two instances reject each other's tokens.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl pkey -in jwt.pem -pubout -out jwt.pub
#   echo "JWT_PRIVATE_KEY=$(tr -d '\r\n' < jwt.pem)" >> .env
#   echo "JWT_PUBLIC_KEY=$(tr -d '\r\n' < jwt.pub)"  >> .env
#   rm jwt.pem jwt.pub
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
