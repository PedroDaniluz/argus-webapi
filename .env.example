# Copie para .env. O Spring le este arquivo via spring.config.import, a partir do
# diretorio de trabalho. Nao confundir com o env_file: do Docker, que injeta
# variavel de ambiente: aqui o arquivo precisa existir no disco.
#
# Nao ha profile. Localhost e a VM rodam a mesma configuracao; o que muda e o
# conteudo deste arquivo.

DATABASE_URL=jdbc:postgresql://localhost:5432/argus
DATABASE_USER=app
DATABASE_PASSWORD=troque-me

# Origens do painel autorizadas no CORS, separadas por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Primeira conta ADMIN, criada pela migration V2. Sem ela nao ha como chamar
# POST /api/users, que exige ADMIN. As duas sao obrigatorias: placeholder de
# Flyway sem valor derruba a subida, o que e melhor do que um hash padrao no
# repositorio virando senha publica.
#
# A senha vai como hash BCrypt, nunca em claro. Para gerar:
#
#   docker run --rm httpd:alpine htpasswd -bnBC 10 "" 'a-senha' | cut -d: -f2
#
# So roda na primeira subida. Trocar a senha depois e UPDATE no banco, nao
# alteracao da migration, que ja esta com checksum registrado.
ADMIN_EMAIL=admin@argus.local
ADMIN_PASSWORD_HASH=

# Par RSA que assina os tokens. OPCIONAL: em branco, a aplicacao gera um par
# efemero na subida e avisa no log. O custo e que todo token emitido morre a cada
# restart, e duas instancias nao validam o token uma da outra. Serve para mexer
# em localhost, nao para a VM.
#
# Gerar e preencher (openssl ja vem no Git Bash), do diretorio do projeto:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl pkey -in jwt.pem -pubout -out jwt.pub
#   echo "JWT_PRIVATE_KEY=$(tr -d '\r\n' < jwt.pem)" >> .env
#   echo "JWT_PUBLIC_KEY=$(tr -d '\r\n' < jwt.pub)"  >> .env
#   rm jwt.pem jwt.pub
#
# O PEM entra em uma linha so, cabecalho junto: a aplicacao remove BEGIN/END e
# espaco antes de decodificar.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
